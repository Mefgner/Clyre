# Clyre environment template.
# Copy this file to `.env` at the project root and fill in the required values.
# Source and Docker installs are user-managed: nothing generates these secrets.

# --- Server ---
# HOST=localhost
# PORT=6750
# DEBUG=False
# TEST_MODE=False

# TEST_MODE=True switches the desktop default chat model from role=chat to
# role=test. Explicit *_MODEL overrides still win, so leave CHAT_MODEL unset to
# use the catalog's test model.

# --- Required secrets (generate fresh random values, >=32 bytes / 64 hex chars) ---
HASHING_SECRET=
ACCESS_TOKEN_SECRET=

# --- Database (desktop defaults to SQLite; Docker sets DATABASE_URL) ---
# DB_ENGINE=sqlite
# DB_RUNTIME=aiosqlite
# DESKTOP_DB_PATH=./data/clyre.sqlite3
# DATABASE_URL=

# --- File storage ---
# FILES_DIR=./data/files

# --- Model endpoints ---
# Values below are optional overrides; defaults come from configs/models.yaml.
# CHAT_BASE_URL=http://localhost:6760
# CHAT_MODEL=Qwen3.5-9B
# EMBEDDING_BASE_URL=http://localhost:6761
# EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# --- Vector store (desktop) ---
# VECTOR_DIM=1024
# DESKTOP_VECTOR_DB_PATH=./data/vectors
