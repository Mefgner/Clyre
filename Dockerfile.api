FROM node:22-alpine AS web-build

WORKDIR /app

COPY package.json package-lock.json /app/
RUN npm ci

COPY web /app/web
COPY index.html /app/index.html
COPY vite.config.mts /app/vite.config.mts
COPY tsconfig.json /app/tsconfig.json
COPY tsconfig.app.json /app/tsconfig.app.json
COPY tsconfig.node.json /app/tsconfig.node.json
COPY env.d.ts /app/env.d.ts

ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/api

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY api /app/api
COPY shared /app/shared
COPY alembic.ini /app/alembic.ini
COPY alembic /app/alembic

COPY --from=web-build /app/dist /app/web/dist

EXPOSE 6750

CMD ["sh", "-c", "python -m db_migrations && uvicorn app:app --host 0.0.0.0 --port 6750"]
